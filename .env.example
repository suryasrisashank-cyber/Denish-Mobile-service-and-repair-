# ==============================================================================
# DENISH MOBILE REPAIRING AND SERVICE - Environment Configuration Example
# Copy to .env.local for local development or configure in Netlify UI for prod.
# NEVER commit .env, .env.local, or real secret values to version control.
# ==============================================================================

# --- Authentication & Session Signing (REQUIRED in production) ----------------
# Generate a strong random secret (32+ chars), e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-strong-random-64-char-secret
# Optional aliases checked as fallbacks if ADMIN_JWT_SECRET is unset:
# JWT_SECRET=
# SESSION_SECRET=

# Force Secure flag on session cookies (set "true" on HTTPS production)
COOKIE_SECURE=true

# --- Initial Admin Bootstrap (Optional - used only if admin_users is empty) ---
# Set temporarily during first bootstrap or use: node scripts/create-admin.js
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Database Storage (Local SQLite only; serverless hosts need external DB) --
# Locally defaults to ./data/denish.sqlite. On serverless hosts without external
# DB migration, ephemeral /tmp/denish.sqlite is NOT persistent across instances.
DATABASE_PATH=./data/denish.sqlite

# --- WhatsApp Cloud API & Webhook Integration (Optional) ----------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_API_TOKEN=replace-with-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_PHONE_NUMBER=replace-with-business-whatsapp-number

# --- Public Site URL (Optional; Netlify also injects URL automatically) -------
NEXT_PUBLIC_SITE_URL=https://your-site-name.netlify.app
